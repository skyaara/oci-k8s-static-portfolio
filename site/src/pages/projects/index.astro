---
import { projects } from '../../data/projects';
import BaseLayout from '../../layouts/BaseLayout.astro';

const sorted = [...projects].sort((a, b) => b.date.localeCompare(a.date));
---

<BaseLayout
  title="Projects"
  description="Selected projects by Your Name."
  path="/projects/"
>
  <h1>Projects</h1>
  <p class="lede">A few things I have built and shipped.</p>
  <div class="card-grid">
    {sorted.map((project) => (
      <article class="card">
        <h2><a href={`/projects/${project.slug}/`}>{project.title}</a></h2>
        <p>{project.description}</p>
        <p><small>{project.tags.join(' · ')}</small></p>
      </article>
    ))}
  </div>
</BaseLayout>
